{
  "Serilog" : {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.AspNetCore.Http.Connections" : "Information"
      }
    },
    "Properties": {
      "Environment": "development"
    },
    "WriteTo": [
      {
        "Name" : "Console",
        "Args" :
        {
          "outputTemplate": "{Timestamp: yyyy-MM-dd HH:mm:ss} [{Level}] {Message} ({Properties}) {NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "outputTemplate": "{Timestamp: yyyy-MM-dd HH:mm:ss} [{Level}] {Message} ({Properties}) {NewLine}{Exception}",
          "buffered": false,
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "path": "C:/_BevenWeddingLogs/Functions/FxApp_.txt"
        }
      }
    ]
  }
}