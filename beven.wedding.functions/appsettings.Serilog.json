{
  "Serilog" : {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Http.Connections" : "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "functionApp",
      "Environment": "production"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp: yyyy-MM-dd HH:mm:ss} [{Level}] {Message} ({Properties}) {NewLine}{Exception}",
          "buffered": true,
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "path": "C:/Home/LogFiles/Application/Functions/FxApp_.txt"
        }
      }
    ]
  }
}